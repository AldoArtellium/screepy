{
  "name": "screepy",
  "version": "0.0.1",
  "description": "screepy Screeps AI",
  "author": "AldoArtellium",
  "license": "WTFPL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AldoArtellium/screepy"
  },
  "homepage": "https://github.com/AldoArtellium/screepy",
  "bugs": {
    "url": "https://github.com/AldoArtellium/screepy/issues"
  },
  "scripts": {
    "build": "tsc -p .",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rimraf tsc-out dist",
    "compile": "rollup -c",
    "push-main": "rollup -c --environment DEST:main",
    "push-sim": "rollup -c --environment DEST:sim",
    "push-seasonal": "rollup -c --environment DEST:seasonal",
    "push-pserver": "rollup -c --environment DEST:pserver",
    "push-screepsplus": "rollup -c --environment DEST:screepsplus",
    "test": "npm run clean && npm run build",
    "test:server": "node scripts/pserver-test.mjs",
    "inspect:server": "node scripts/pserver-inspect.mjs",
    "watch:server": "node scripts/pserver-client.mjs"
  },
  "engines": {
    "node": "^20.11"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@types/lodash": "^3.10.2",
    "@types/node": "^20.11.16",
    "@types/screeps": "^3.3.7",
    "@types/screeps-profiler": "^1.2.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "rollup": "^2.79.1",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-progress": "^1.1.1",
    "rollup-plugin-screeps": "^1.0.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "typedoc": "^0.14.2",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^1.2.11",
    "columnify": "1.5.4",
    "onnxjs": "^0.1.6",
    "screeps-cache": "^1.0.11",
    "screeps-cartographer": "^1.6.3",
    "screeps-viz": "^2.1.3",
    "source-map": "0.7.3"
  }
}
